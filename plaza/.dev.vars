# Local `wrangler dev` configuration. Checked in: nothing here is secret.
# PLAZA_PASS_PUBLIC_KEY is the DEV-ONLY public key from dev-keys.env (never deploy with it).
PLAZA_PASS_PUBLIC_KEY=HukkwyqykKbctQCEKiJF7r19upYxaXKyTrSxEfWLt0A=
PLAZA_ALLOWED_ORIGINS=http://localhost:3312,http://127.0.0.1:3312
# Dev only: also accept http://localhost:<any port> and http://127.0.0.1:<any port>
# (the repo's e2e tests run the main server on random ports).
PLAZA_ALLOW_LOCALHOST_ANY_PORT=1
